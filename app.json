{
  "expo": {
    "name": "Manila",
    "slug": "manila",
    "version": "0.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "manila",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ace9025c-57c1-498b-b1da-72b44f77c820"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usemanila.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Manila uses your camera to capture receipts.",
        "NSPhotoLibraryUsageDescription": "Manila accesses your photo library so you can pick existing receipt photos.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.269882818913-ghq48i534j57f92v6psubepv9ocfq0ng"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.usemanila.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C6633A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.269882818913-b6o0rp039qkfr54h7oblantvdf4b2kee"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Manila to use your camera to capture receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Manila to access your photos so you can pick existing receipt images.",
          "cameraPermission": "Allow Manila to use your camera to capture receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ace9025c-57c1-498b-b1da-72b44f77c820"
      },
      "googleIosClientId": "269882818913-ghq48i534j57f92v6psubepv9ocfq0ng.apps.googleusercontent.com",
      "googleAndroidClientId": "269882818913-b6o0rp039qkfr54h7oblantvdf4b2kee.apps.googleusercontent.com"
    }
  }
}
