# Anthropic API key for Claude vision receipt extraction.
# Get one at https://console.anthropic.com/
# NOTE: Bundled into the app for demo. Swap to a proxy before distributing.
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model to use for receipt vision extraction.
# Default: claude-opus-4-7 (most capable). Switch to claude-sonnet-4-6 to cut cost ~5x.
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-4-7

# Google OAuth 2.0 Web Client ID for Drive sync.
# Create at https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application.
# Add https://auth.expo.io/@your-expo-username/schedule-e-ai to the authorized redirect URIs.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
