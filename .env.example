# Receipt-extraction backend (Cloudflare Worker — see workers/extract/).
# The Worker holds the Anthropic API key server-side so it never ships in the
# app bundle. After deploying the Worker, paste its URL here and the same
# APP_SHARED_SECRET you set as a Worker secret.
EXPO_PUBLIC_EXTRACT_URL=https://manila-extract.<your-subdomain>.workers.dev
EXPO_PUBLIC_APP_TOKEN=

# Google OAuth 2.0 Web Client ID for Drive sync. Only works in a dev build /
# real build — Expo Go can't register the manila:// scheme that OAuth
# needs. See app/settings.tsx (long-press "Settings" for the redirect URI).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
